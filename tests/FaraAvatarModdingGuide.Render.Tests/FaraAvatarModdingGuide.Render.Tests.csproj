  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FaraAvatarModdingGuide.Render\FaraAvatarModdingGuide.Render.csproj" />
    <!-- 突き合わせの入力(ViewportDriver・JsReference)は Practice.Tests のものを使う -->
