@inject IOptions<SiteOptions> Site

<!DOCTYPE html>
<html lang="ja" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // テーマ（ダーク / ライト）。描画前に localStorage の値を反映して、ちらつきを防ぐ
        (function () {
            try { var t = localStorage.getItem("blender-manual.theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-bs-theme", t); } catch (e) { }
            var q = new URLSearchParams(location.search).get("theme"); // ?theme=light で一時的に切り替え（確認用）
            if (q === "light" || q === "dark") document.documentElement.setAttribute("data-bs-theme", q);
            window.faraUpdateThemeButton = function () {
                var b = document.getElementById("theme-toggle");
                if (b) b.textContent = document.documentElement.getAttribute("data-bs-theme") === "dark" ? "☀ ライトモード" : "🌙 ダークモード";
            };
            window.faraToggleTheme = function () {
                var h = document.documentElement;
                var t = h.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
                h.setAttribute("data-bs-theme", t);
                try { localStorage.setItem("blender-manual.theme", t); } catch (e) { }
                window.faraUpdateThemeButton();
            };
            document.addEventListener("DOMContentLoaded", window.faraUpdateThemeButton);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="images/blender-logo.svg" />
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
</html>
