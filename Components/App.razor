@inject IOptions<SiteOptions> Site

<!DOCTYPE html>
<html lang="ja" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // テーマ（ダーク / ライト）。描画前に localStorage の値を反映して、ちらつきを防ぐ
        (function () {
            // サイドバーを隠す設定（PC）。描画の前に反映して、ちらつきを防ぐ（切り替えは js/sidebar.js）
            try { if (localStorage.getItem("avatar-modding-guide.sidebar-hidden") === "1") document.documentElement.classList.add("sidebar-hidden"); } catch (e) { }
            try { var t = localStorage.getItem("avatar-modding-guide.theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-bs-theme", t); } catch (e) { }
            var q = new URLSearchParams(location.search).get("theme"); // ?theme=light で一時的に切り替え（確認用）
            if (q === "light" || q === "dark") document.documentElement.setAttribute("data-bs-theme", q);
            window.faraUpdateThemeButton = function () {
                var b = document.getElementById("theme-toggle");
                if (b) b.textContent = document.documentElement.getAttribute("data-bs-theme") === "dark" ? "☀ ライトモード" : "🌙 ダークモード";
            };
            window.faraToggleTheme = function () {
                var h = document.documentElement;
                var t = h.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
                h.setAttribute("data-bs-theme", t);
                try { localStorage.setItem("avatar-modding-guide.theme", t); } catch (e) { }
                window.faraUpdateThemeButton();
                if (window.faraSyncThemeSwitch) window.faraSyncThemeSwitch();
            };
            document.addEventListener("DOMContentLoaded", window.faraUpdateThemeButton);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
    <link href="css/site.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="images/site-icon.svg" />
    <script src="js/nav.js" defer></script>
    <script src="js/sidebar.js" defer></script>
    <script src="js/scrollprogress.js" defer></script>
    <script src="js/bgscene.js" defer></script>
    <script src="js/progress.js" defer></script>
    <script src="js/searchcore.js" defer></script>
    <script src="js/quicksearch.js" defer></script>
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
</html>
