@* サイト内検索の欄（すべてのページ）。候補の表示は wwwroot/js/quicksearch.js。JS がなくても /search へ送信できる。
   PC はヘッダー、スマホは本文の上に出す（同じ画面に 2 つ置くので、id は IdPrefix で分ける）。一致した場所の種類・小見出し・前後の文章を出す *@
<form action="/search" method="get" role="search" class="quick-search" data-quick-search>
    <i class="bi bi-search quick-search-icon" aria-hidden="true"></i>
    <input id="@(IdPrefix)-input" name="q" type="search" class="form-control" placeholder="検索（例: 押し出し、Ctrl+R、ウェイト）"
           autocomplete="off" aria-label="サイト内を検索" role="combobox" aria-expanded="false" aria-controls="@(IdPrefix)-list" aria-autocomplete="list" />
    <span class="quick-search-hint" aria-hidden="true"><kbd>Ctrl</kbd><kbd>K</kbd></span>
    <div id="@(IdPrefix)-list" tabindex="-1" class="quick-search-list" role="listbox" aria-label="検索の候補" hidden></div>
</form>

@code {
    /// <summary>この欄の id の頭（同じ画面に 2 つ置くため）。</summary>
    [Parameter] public string IdPrefix { get; set; } = "qs";
}
