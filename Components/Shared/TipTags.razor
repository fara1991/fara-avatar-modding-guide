@* 項目のタグと出どころ *@
<div class="tip-tags">
    @foreach (var tag in Tags)
    {
        <span class="tip-tag">@tag</span>
    }
    @if (Source == "discord")
    {
        <span class="tip-tag tip-source-discord" title="Discord での質問・会話をもとにした項目"><i class="bi bi-discord" aria-hidden="true"></i> Discord より</span>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<string> Tags { get; set; } = [];
    [Parameter] public string Source { get; set; } = "manual";
}
