@* 用語集・何て名前？・TIPS・Q&A の「詳しく」（Markdown の本文）。#id で飛んできたときは tipsfilter.js が開く *@
@if (!string.IsNullOrWhiteSpace(Markdown))
{
    <details class="tip-body mb-2">
        <summary>@Label</summary>
        <div class="tip-body-content">@((MarkupString)ContentService.RenderInline(Markdown))</div>
    </details>
}

@code {
    [Parameter] public string? Markdown { get; set; }
    [Parameter] public string Label { get; set; } = "詳しく";
}
