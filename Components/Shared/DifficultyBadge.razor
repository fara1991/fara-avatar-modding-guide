@if (!string.IsNullOrEmpty(Difficulty))
{
    <span class="badge @CssClass">@Difficulty</span>
}

@code {
    [Parameter] public string? Difficulty { get; set; }

    private string CssClass => Difficulty switch
    {
        "初級" => "bg-success",
        "中級" => "bg-warning text-dark",
        "上級" => "bg-danger",
        _ => "bg-secondary"
    };
}
