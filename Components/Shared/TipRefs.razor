@inject ContentService Content

@* 用語集・何て名前？・TIPS・Q&A の各項目の「キー / 記事 / 関連する用語 / 関連する言葉」 *@
@if (Shortcuts.Count > 0 || Articles.Count > 0 || Related.Count > 0 || Keywords.Count > 0)
{
    <div class="tip-refs">
        @if (Shortcuts.Count > 0)
        {
            <div><span class="tip-refs-label">キー</span>
                @foreach (var key in Shortcuts)
                {
                    var s = Content.Shortcuts.FirstOrDefault(x => x.Key == key);
                    if (s is null)
                    {
                        <kbd>@key</kbd>
                    }
                    else
                    {
                        <a href="/shortcuts?category=@Uri.EscapeDataString(s.Category)" class="text-decoration-none" title="@s.Function"><kbd>@key</kbd></a>
                    }
                }
            </div>
        }
        @if (Articles.Count > 0)
        {
            <div><span class="tip-refs-label">記事</span>
                @foreach (var (id, i) in Articles.Select((a, i) => (a, i)))
                {
                    var article = Content.Articles.FirstOrDefault(a => a.Id == id);
                    if (article is null) continue;
                    @if (i > 0) { <span class="text-body-secondary"> / </span> }
                    <a href="@article.Url">@article.Title</a>
                }
            </div>
        }
        @if (Related.Count > 0)
        {
            <div><span class="tip-refs-label">関連</span>
                @foreach (var (id, i) in Related.Select((r, i) => (r, i)))
                {
                    var term = Content.Glossary.FirstOrDefault(g => g.Id == id);
                    if (term is null) continue;
                    @if (i > 0) { <span class="text-body-secondary"> / </span> }
                    <a href="/glossary#@term.Id">@term.Term</a>
                }
            </div>
        }
        @if (Keywords.Count > 0)
        {
            <div><span class="tip-refs-label">関連語</span>
                <span class="tip-keywords">@string.Join(" / ", Keywords)</span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<string> Shortcuts { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Articles { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Related { get; set; } = [];
    /// <summary>用語集に無い関連語（リンクにせず文字のまま出す）</summary>
    [Parameter] public IReadOnlyList<string> Keywords { get; set; } = [];
}
