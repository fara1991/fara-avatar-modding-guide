@inject ContentService Content

@* 完了したページの件数と「次に読む」リンク。中身は wwwroot/js/progress.js が localStorage から埋める *@
<div class="progress-summary card mb-4" data-progress-summary data-articles="@string.Join(' ', ids)"
     data-progress-hide-empty="@(HideWhenEmpty ? "" : null)" hidden="@HideWhenEmpty">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div class="flex-grow-1">
            <div class="fw-semibold"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i><span data-progress-count>@ids.Count ページ中 0 ページ完了</span></div>
            <div class="progress-track mt-2" aria-hidden="true"><span data-progress-bar></span></div>
        </div>
        <a class="btn btn-primary" href="/learn" data-progress-next hidden>
            次に読む: <span data-progress-next-title></span> <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
        @if (ShowReset)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" data-progress-reset>
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> 記録を消す
            </button>
        }
    </div>
    @if (ShowNote)
    {
        <div class="card-footer small text-body-secondary">
            各ページの最後にある「このページを完了にする」で記録できます（ページ内の「やってみよう」を最後まで進めても完了になります）。記録はこのブラウザにだけ保存され、ログインは不要です。別のブラウザや端末には引き継がれません。
        </div>
    }
</div>

@code {
    /// <summary>まだ 1 ページも完了していなければ表示しない</summary>
    [Parameter] public bool HideWhenEmpty { get; set; }
    [Parameter] public bool ShowReset { get; set; }
    [Parameter] public bool ShowNote { get; set; }

    private List<string> ids = [];

    protected override void OnParametersSet()
    {
        ids = Content.Categories.SelectMany(c => Content.GetArticles(c.Id)).Select(a => a.Id).ToList();
    }
}
