@page "/addons"
@inject ContentService Content
@inject IOptions<SiteOptions> Site

<PageTitle>アドオン - @Site.Value.Title</PageTitle>

<h1>おすすめアドオン</h1>
<p class="lead">Blender の機能を拡張する便利なアドオンを紹介します。</p>

<div class="row g-4">
    @foreach (var addon in Content.Addons)
    {
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h5 class="card-title mb-0">@addon.Name</h5>
                        <span class="badge @GetTypeBadgeClass(addon.Type)">@addon.Type</span>
                    </div>
                    @if (!string.IsNullOrEmpty(addon.Status))
                    {
                        <span class="badge bg-warning text-dark mb-2"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @addon.Status</span>
                    }
                    <p class="card-text">@addon.Description</p>
                    @if (!string.IsNullOrEmpty(addon.Note))
                    {
                        <p class="card-text small text-body-secondary border-start border-3 border-warning ps-2">@addon.Note</p>
                    }
                    <ul class="mb-3">
                        @foreach (var feature in addon.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-body-secondary">価格: @addon.Price</small>
                        @if (!string.IsNullOrEmpty(addon.Url))
                        {
                            <a href="@addon.Url" target="_blank" rel="noopener" class="btn btn-primary btn-sm">公式サイト <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="alert alert-info mt-4" role="alert">
    <h4 class="alert-heading h5">アドオンのインストール方法（Blender 4.2 以降）</h4>
    <p class="mb-2"><strong>Extensions Platform に掲載されているもの</strong>（Node Wrangler など）</p>
    <ol>
        <li>Edit &gt; Preferences を開く</li>
        <li>Get Extensions タブで名前を検索</li>
        <li>Install をクリック（自動で有効化される）</li>
    </ol>
    <p class="mb-2"><strong>.zip で配布されているもの</strong>（GitHub や Gumroad から入手したアドオン）</p>
    <ol class="mb-2">
        <li>Edit &gt; Preferences を開く</li>
        <li>Add-ons タブ右上の <kbd>∨</kbd> メニューから Install from Disk... を選択</li>
        <li>ダウンロードした .zip ファイルを選択</li>
        <li>一覧でチェックを入れて有効化</li>
    </ol>
    <p class="mb-0 small">Blender 4.1 以前は Add-ons タブの Install... ボタンから .zip を選びます。</p>
</div>

@code {
    private static string GetTypeBadgeClass(string type) => type switch
    {
        "モデリング" => "bg-success",
        "アニメーション" => "bg-primary",
        "レンダリング" => "bg-warning text-dark",
        "ユーティリティ" => "bg-info text-dark",
        "ゲーム開発" => "bg-secondary",
        _ => "bg-dark"
    };
}
