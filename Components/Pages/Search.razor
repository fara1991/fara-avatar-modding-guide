@page "/search"
@inject IOptions<SiteOptions> Site

<PageTitle>検索 - @Site.Value.Title</PageTitle>

<h1>検索</h1>
<p class="lead">記事・用語集・「何て名前？」・TIPS・改変 Q&amp;A・ショートカット・アドオン・リンク集をまとめて検索します。どのページでも <kbd>Ctrl</kbd>+<kbd>K</kbd> か <kbd>/</kbd> で上の検索欄に移動できます。</p>

<form id="search-form" action="/search" method="get" class="mb-4" role="search">
    <div class="input-group input-group-lg">
        <input id="search-input" name="q" type="search" class="form-control" placeholder="例: 押し出し、Ctrl+R、ウェイト" value="@Q" autofocus autocomplete="off" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> 検索</button>
    </div>
</form>

<div id="search-results" aria-live="polite">
    <noscript><p class="text-danger">検索には JavaScript が必要です。</p></noscript>
    @* 試作: 検索の結果は Blazor WebAssembly の島（islands/search）が描く。島は、この本文の中の script で読み込む（ページ移動のときも同じ） *@
    <fara-search></fara-search>
</div>

<script src="/js/island-search.js"></script>
<script src="/_framework/blazor.webassembly.js"></script>

@code {
    [SupplyParameterFromQuery] public string? Q { get; set; }
}
