@page "/links"
@inject ContentService Content
@inject IOptions<SiteOptions> Site

<PageTitle>リンク集 - @Site.Value.Title</PageTitle>
<HeadContent><meta name="description" content="アバター改変で使う Unity のツール、VRChat の資料、参考になる記事・動画、話題になった BOOTH のアバター・衣装のリンク集です。" /></HeadContent>

<h1>リンク集</h1>
<p class="lead">アバター改変の相談で紹介されたツール・資料・商品のリンクです。Blender のアドオンは <a href="/addons">アドオン</a> のページにまとめています。</p>
<p class="small text-body-secondary">外部のサイトです。配布・販売の状況や対応バージョンは変わることがあるので、使う前・買う前にリンク先で確かめてください。<span class="badge bg-warning text-dark">古い情報</span> は、今は別の方法が主流になっている・販売や更新が終わっている可能性があるものです。</p>

<nav class="links-toc mb-4" aria-label="区切り">
    @foreach (var c in Categories)
    {
        <a href="#@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi @c.Icon" aria-hidden="true"></i> @c.Title <span class="text-body-secondary">(@Content.Links.Count(l => l.Category == c.Id))</span></a>
    }
</nav>

@foreach (var c in Categories)
{
    <section class="links-section mb-5" id="@c.Id">
        <h2 class="h4"><i class="bi @c.Icon me-2" aria-hidden="true"></i>@c.Title</h2>
        <p class="text-body-secondary small">@c.Description</p>
        <ul class="link-list list-unstyled">
            @foreach (var l in Content.Links.Where(l => l.Category == c.Id))
            {
                <li class="link-item" id="@l.Id">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <a href="@l.Url" target="_blank" rel="noopener" class="link-name">@l.Name <i class="bi bi-box-arrow-up-right small" aria-hidden="true"></i></a>
                        @if (l.Status == "old")
                        {
                            <span class="badge bg-warning text-dark" title="今は別の方法が主流・販売や更新が終わっている可能性があります">古い情報</span>
                        }
                        else if (l.Status == "current")
                        {
                            <span class="badge bg-success" title="今も使われているもの">今も使われている</span>
                        }
                        @if (l.Source == "discord")
                        {
                            <span class="tip-tag tip-source-discord" title="Discord での質問・会話で紹介されたもの"><i class="bi bi-discord" aria-hidden="true"></i> Discord より</span>
                        }
                    </div>
                    <div class="small">@l.Description</div>
                    @if (!string.IsNullOrEmpty(l.Note))
                    {
                        <div class="small text-body-secondary">@l.Note</div>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    private IEnumerable<LinkCategory> Categories =>
        ContentService.LinkCategories.Where(c => Content.Links.Any(l => l.Category == c.Id));
}
