@page "/howto"
@inject ContentService Content
@inject IOptions<SiteOptions> Site

<PageTitle>あの操作、何て名前？ - @Site.Value.Title</PageTitle>
<HeadContent><meta name="description" content="「頂点をくっつけたい」のようなやりたいことから、Blender・Unity・VRChat の操作の名前・メニューの場所・ショートカットを引けます。" /></HeadContent>

<h1>あの操作、何て名前？</h1>
<p class="lead">やりたいことから、操作の名前・メニューの場所（日本語 / 英語 UI）・キーを引けます。名前がわかれば、Blender では <kbd>F3</kbd>（メニュー検索）にそのまま入力して実行できます。</p>

<TipsFilter Tags="@Content.TipTags(Content.Howtos.Select(h => h.Tags))" Placeholder="やりたいことで絞り込む（例: くっつけ、穴、揺らす）" HasDiscord="@Content.Howtos.Any(h => h.Source == "discord")" Count="@Content.Howtos.Count" />

<div class="row g-3">
    @foreach (var h in Content.Howtos)
    {
        <div class="col-lg-6" data-tip-item>
            <article class="tip-card card h-100" id="@h.Id" data-tags="@string.Join('|', h.Tags)" data-source="@h.Source" data-aliases="@string.Join(' ', h.Aliases)">
                <div class="card-body">
                    <h2 class="h5 mb-2"><a href="#@h.Id" class="tip-anchor">@h.Question</a></h2>
                    <p class="howto-answer mb-2">
                        <i class="bi bi-arrow-return-right" aria-hidden="true"></i>
                        <strong>@h.Answer</strong>
                        @if (!string.IsNullOrEmpty(h.AnswerEn))
                        {
                            <span class="tip-en">@h.AnswerEn</span>
                        }
                        @foreach (var key in h.Shortcuts)
                        {
                            <kbd class="ms-1">@key</kbd>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(h.Menu))
                    {
                        <dl class="howto-menu small mb-2">
                            <dt>メニュー</dt>
                            <dd>@h.Menu</dd>
                            @if (!string.IsNullOrEmpty(h.MenuEn))
                            {
                                <dt>英語 UI</dt>
                                <dd>@h.MenuEn</dd>
                            }
                        </dl>
                    }
                    @if (!string.IsNullOrEmpty(h.Note))
                    {
                        <p class="small mb-2">@((MarkupString)ContentService.RenderInline(h.Note))</p>
                    }
                    <TipBody Markdown="@h.Body" />
                    <TipTags Tags="@h.Tags" Source="@h.Source" />
                    <TipRefs Articles="@h.Articles" Related="@h.Related" Keywords="@h.Keywords" />
                </div>
            </article>
        </div>
    }
</div>

<script src="/js/tipsfilter.js" defer></script>
