@page "/"
@inject IOptions<SiteOptions> Site
@inject ContentService Content

<PageTitle>ホーム - @Site.Value.Title</PageTitle>

@* サイト名と説明（ポケモン・Bot のサイトと同じ作り。箱で囲まず、グラデーションの文字） *@
<div class="home-header">
    <h1 class="home-title">@Site.Value.Title</h1>
    <p class="home-lead mb-3">
        アバター改変のための Blender・Unity・VRChat の操作ガイドです。Blender でのモデリングから Unity での衣装・マテリアルの設定、VRChat へのアップロードまでをまとめています。<br />
        初めての方は下の目次を上から順に読んでください。
    </p>
    <a href="/learn" class="btn btn-primary btn-lg">
        <i class="bi bi-book" aria-hidden="true"></i> はじめから読む
    </a>
</div>

<section class="mb-5">
    <h2 class="h3 mb-3">更新履歴</h2>
    <ul class="changelog-recent list-unstyled mb-2">
        @foreach (var e in Content.Changelog.Take(RecentCount))
        {
            <li><span class="changelog-date">@e.Date.ToString("MM/dd")</span> @e.Title</li>
        }
    </ul>
    <a href="/changelog" class="btn btn-sm btn-outline-primary">すべて見る</a>
</section>

<section class="mb-5">
    <h2 class="h3 mb-3">目次</h2>
    <ProgressSummary HideWhenEmpty="true" />
    <Roadmap />
</section>

<section class="mb-5">
    <h2 class="h3 mb-3">困ったときに引く</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <a href="/howto" class="card h-100 text-decoration-none article-card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-question-circle me-2" aria-hidden="true"></i>あの操作、何て名前？</h5>
                    <p class="card-text text-body-secondary">「頂点をくっつけたい」から、操作の名前・メニュー・キーを引けます。</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/tips" class="card h-100 text-decoration-none article-card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-lightbulb me-2" aria-hidden="true"></i>TIPS</h5>
                    <p class="card-text text-body-secondary">Unity でピンクになる、服がついてこないなど、よくあるつまずきと直し方。</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/qa" class="card h-100 text-decoration-none article-card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-chat-left-text me-2" aria-hidden="true"></i>改変 Q&amp;A</h5>
                    <p class="card-text text-body-secondary">非対応衣装・ウェイト・首すげ替え・色変えなど、改変の相談でよく出た質問と手順。</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/glossary" class="card h-100 text-decoration-none article-card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-journal-text me-2" aria-hidden="true"></i>用語集</h5>
                    <p class="card-text text-body-secondary">Blender・Unity・VRChat の言葉を、英語 UI の表記と一緒に。</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/shortcuts" class="card h-100 text-decoration-none article-card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-keyboard me-2" aria-hidden="true"></i>ショートカット一覧</h5>
                    <p class="card-text text-body-secondary">キーから機能を逆引きできます。</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/addons" class="card h-100 text-decoration-none article-card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-puzzle me-2" aria-hidden="true"></i>アドオン</h5>
                    <p class="card-text text-body-secondary">作業を楽にするアドオンの紹介。</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/links" class="card h-100 text-decoration-none article-card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-link-45deg me-2" aria-hidden="true"></i>リンク集</h5>
                    <p class="card-text text-body-secondary">Unity のツール、参考になる記事、話題になった BOOTH のアバター・衣装。</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/practice" class="card h-100 text-decoration-none article-card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-controller me-2" aria-hidden="true"></i>操作の練習</h5>
                    <p class="card-text text-body-secondary">ブラウザ上で、Blender と同じキー操作を試せます。</p>
                </div>
            </a>
        </div>
    </div>
</section>

@code {
    /// <summary>ホームに出す更新履歴の件数（細かい内容は /changelog）。</summary>
    private const int RecentCount = 3;
}
