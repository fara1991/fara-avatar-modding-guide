@page "/learn/{CategoryId}/{Slug}"
@inject ContentService Content
@using System.Net
@using System.Text.RegularExpressions
@inject IOptions<SiteOptions> Site

@if (article is null || category is null)
{
    <PageTitle>記事が見つかりません - @Site.Value.Title</PageTitle>
    <h1>記事が見つかりません</h1>
    <p role="alert">お探しの記事は移動したか、削除された可能性があります。</p>
    <a href="/learn" class="btn btn-primary">ロードマップへ戻る</a>
}
else
{
    <PageTitle>@article.Title - @Site.Value.Title</PageTitle>
    <HeadContent>
        <meta name="description" content="@article.Description" />
    </HeadContent>

    <nav aria-label="パンくず">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/learn">目次</a></li>
            @if (Content.GetSection(category.Section) is { } section)
            {
                <li class="breadcrumb-item"><a href="/learn#section-@section.Id">@section.Title</a></li>
            }
            <li class="breadcrumb-item"><a href="/learn/@category.Id">@category.Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">@article.Title</li>
        </ol>
    </nav>

    @* data-progress-page / data-article / data-progress-toggle は wwwroot/js/progress.js が見る（完了の記録） *@
    <header class="article-header mb-4" data-progress-page="@article.Id">
        <h1>@article.Title</h1>
        <div class="d-flex flex-wrap align-items-center gap-2 text-body-secondary small">
            <span class="done-mark badge-done" data-article="@article.Id"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> 完了</span>
            <DifficultyBadge Difficulty="@article.Difficulty" />
            @* 対象のソフトとバージョン。Unity / VRChat の区切りの記事は Unity のバージョン *@
            @if (category.Section is "unity" or "vrchat")
            {
                <span><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Unity @Site.Value.UnityVersion</span>
            }
            else
            {
                <span><i class="bi bi-box" aria-hidden="true"></i> Blender @(article.BlenderVersion ?? Site.Value.BlenderVersion)</span>
            }
            @if (article.Updated is { } updated)
            {
                <span><i class="bi bi-clock-history" aria-hidden="true"></i> 更新: @updated.ToString("yyyy-MM-dd")</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(article.Description))
        {
            <p class="lead mt-2 mb-0">@article.Description</p>
        }
    </header>

    @* スマートフォンでは記事タイトルの下に畳んで置く。PC は右の列（toc.js が今読んでいる見出しを強調する） *@
    @if (headings.Count > 0)
    {
        <details class="article-toc-mobile d-lg-none mb-4">
            <summary>この記事の目次（@headings.Count）</summary>
            <ol class="toc-list">
                @foreach (var h in headings)
                {
                    <li><a href="@article.Url#@h.Id">@h.Text</a></li>
                }
            </ol>
        </details>
    }

    <div class="row g-4">
        <div class="@(hasAside ? "col-lg-9" : "col-12")">
            <div class="article-body">
                @((MarkupString)article.Html)
            </div>
        </div>

        @if (hasAside)
        {
            <aside class="col-lg-3" aria-label="この記事の補足">
                <div class="article-aside">
                    @if (headings.Count > 0)
                    {
                        <nav class="article-toc d-none d-lg-block" aria-labelledby="article-toc-title">
                            <div class="article-toc-title" id="article-toc-title">この記事の目次</div>
                            <ol class="toc-list">
                                @foreach (var h in headings)
                                {
                                    <li><a href="@article.Url#@h.Id">@h.Text</a></li>
                                }
                            </ol>
                        </nav>
                    }
                    @if (article.Shortcuts.Count > 0)
                    {
                        <div class="card article-keys">
                            <div class="card-header"><i class="bi bi-keyboard me-1" aria-hidden="true"></i>この記事で使うキー</div>
                            <ul class="list-group list-group-flush">
                                @foreach (var key in article.Shortcuts)
                                {
                                    var shortcut = Content.Shortcuts.FirstOrDefault(s => s.Key == key);
                                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                        <kbd>@key</kbd>
                                        @if (shortcut is not null)
                                        {
                                            <a href="/shortcuts?category=@Uri.EscapeDataString(shortcut.Category)" class="small text-decoration-none">@shortcut.Function</a>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </aside>
        }
    </div>

    <div class="article-complete d-flex flex-wrap align-items-center gap-3 mt-5">
        <button type="button" class="btn btn-progress" data-progress-toggle="@article.Id" aria-pressed="false">
            <i class="bi bi-circle" aria-hidden="true"></i> このページを完了にする
        </button>
        <span class="small text-body-secondary">完了の記録はこのブラウザにだけ保存されます。</span>
    </div>

    <nav class="article-nav d-flex justify-content-between gap-3 mt-4 pt-4 border-top" aria-label="前後の記事">
        @if (prev is not null)
        {
            <a href="@prev.Url" class="btn btn-outline-secondary text-start">
                <small class="d-block text-body-secondary">← 前へ</small>@prev.Title
            </a>
        }
        else
        {
            <span></span>
        }
        @if (next is not null)
        {
            <a href="@next.Url" class="btn btn-primary text-end">
                <small class="d-block">次へ →</small>@next.Title
            </a>
        }
    </nav>

    @if (headings.Count > 0)
    {
        <script src="/js/toc.js" defer></script>
    }

    @if (article.PracticeScenarios.Count > 0)
    {
        @* 記事内チュートリアル（::: practice）。three.js は埋め込みが画面に入ったときに tutorial.js が読み込む *@
        <script type="importmap">
        {
            "imports": {
                "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"
            },
            "integrity": {
                "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js": "sha384-GY5FqjttLCFRt/McQbyaVdCk2O1IQtOeX8Py6NfD89BIAsIyJFRl4UgSXrk2vXAk"
            }
        }
        </script>
        <script type="module" src="/js/tutorial.js"></script>
    }
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Parameter] public string CategoryId { get; set; } = string.Empty;
    [Parameter] public string Slug { get; set; } = string.Empty;

    private LearnCategory? category;
    private Article? article;
    private Article? prev;
    private Article? next;
    private IReadOnlyList<TocItem> headings = [];
    // 目次は h2 が 3 個以上の記事だけ。PC は右の列に目次とキー一覧を並べる
    private bool hasAside => article is not null && (headings.Count > 0 || article.Shortcuts.Count > 0);

    private sealed record TocItem(string Id, string Text);

    private static readonly Regex H2Pattern = new(@"<h2 id=""([^""]+)""[^>]*>(.*?)</h2>", RegexOptions.Singleline | RegexOptions.Compiled);

    /// <summary>本文 HTML の h2（Markdig が id を付けたもの）を拾う。2 個以下なら目次は出さない。</summary>
    private static IReadOnlyList<TocItem> ExtractHeadings(string html)
    {
        var list = H2Pattern.Matches(html)
            .Select(m => new TocItem(WebUtility.HtmlDecode(m.Groups[1].Value), WebUtility.HtmlDecode(Regex.Replace(m.Groups[2].Value, "<[^>]+>", "")).Trim()))
            .Where(h => h.Text.Length > 0)
            .ToList();
        return list.Count > 2 ? list : [];
    }

    protected override void OnParametersSet()
    {
        category = Content.GetCategory(CategoryId);
        article = category is null ? null : Content.GetArticle(category.Id, Slug);
        (prev, next) = article is null ? (null, null) : Content.GetNeighbors(article);
        headings = article is null ? [] : ExtractHeadings(article.Html);
        if (article is null && HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
