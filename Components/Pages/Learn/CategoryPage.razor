@page "/learn/{CategoryId}"
@inject ContentService Content
@inject IOptions<SiteOptions> Site

@if (category is null)
{
    <PageTitle>カテゴリが見つかりません - @Site.Value.Title</PageTitle>
    <h1>カテゴリが見つかりません</h1>
    <p role="alert">「@CategoryId」というカテゴリはありません。</p>
    <a href="/learn" class="btn btn-primary">ロードマップへ戻る</a>
}
else
{
    <PageTitle>@category.Title - @Site.Value.Title</PageTitle>

    <nav aria-label="パンくず">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/learn">目次</a></li>
            @if (Content.GetSection(category.Section) is { } section)
            {
                <li class="breadcrumb-item"><a href="/learn#section-@section.Id">@section.Title</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@category.Title</li>
        </ol>
    </nav>

    <h1>
        <i class="bi @category.Icon me-2" aria-hidden="true"></i>@category.Title
        @if (articles.Count > 0)
        {
            <span class="category-progress" data-category-progress="@category.Id" data-articles="@string.Join(' ', articles.Select(a => a.Id))" hidden></span>
        }
    </h1>
    <p class="lead">@category.Description</p>

    @if (articles.Count == 0)
    {
        <div class="alert alert-secondary">このカテゴリの記事は準備中です。</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var article in articles)
            {
                <div class="col-md-6 col-xl-4">
                    <ArticleCard Article="article" />
                </div>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Parameter] public string CategoryId { get; set; } = string.Empty;

    private LearnCategory? category;
    private IReadOnlyList<Article> articles = [];

    protected override void OnParametersSet()
    {
        category = Content.GetCategory(CategoryId);
        articles = category is null ? [] : Content.GetArticles(category.Id);
        if (category is null && HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
