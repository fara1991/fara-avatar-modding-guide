@page "/shortcuts"
@inject ContentService Content
@inject IOptions<SiteOptions> Site

<PageTitle>ショートカット一覧 - @Site.Value.Title</PageTitle>

<h1>ショートカット一覧</h1>
<p class="lead">Blender でよく使うキーボードショートカットを機能別に整理しました。</p>

@* 全件を描画し、?category= による絞り込みは wwwroot/js/shortcuts.js で行う。
   静的サイトとして書き出しても 1 つの HTML で済み、URL は共有できる。 *@
<div id="shortcut-filters" class="mb-3 d-flex flex-wrap gap-2">
    <a href="/shortcuts" class="btn btn-sm btn-primary" data-category="">すべて</a>
    @foreach (var c in Content.ShortcutCategories)
    {
        <a href="/shortcuts?category=@Uri.EscapeDataString(c)" class="btn btn-sm btn-outline-primary" data-category="@c">@c</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ショートカット</th>
                <th>機能</th>
                <th>カテゴリ</th>
                <th>説明</th>
            </tr>
        </thead>
        <tbody id="shortcut-rows">
            @foreach (var shortcut in Content.Shortcuts)
            {
                <tr data-category="@shortcut.Category">
                    <td><kbd>@shortcut.Key</kbd></td>
                    <td>@shortcut.Function</td>
                    <td><span class="badge @GetCategoryBadgeClass(shortcut.Category)">@shortcut.Category</span></td>
                    <td>@shortcut.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="/js/shortcuts.js" defer></script>

@code {
    private static string GetCategoryBadgeClass(string category) => category switch
    {
        "一般" => "bg-primary",
        "モデリング" => "bg-success",
        "編集" => "bg-warning text-dark",
        "表示" => "bg-info text-dark",
        "選択" => "bg-secondary",
        _ => "bg-dark"
    };
}
