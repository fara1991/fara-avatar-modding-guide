@inherits LayoutComponentBase
@inject IOptions<SiteOptions> Site
@inject NavigationManager Nav

@* <base href="/"> があるので、# だけの href はトップへ飛んでしまう。いまのパスを付ける *@
<a class="skip-link" href="@(new Uri(Nav.Uri).AbsolutePath)#main-content">本文へスキップ <kbd>Enter</kbd></a>

<div class="page">
    <div class="sidebar" id="site-sidebar">
        <NavMenu />
    </div>

    @* サイドバーを隠しているときだけ（PC）、左上に出る「開く」ボタン。押す処理は wwwroot/js/sidebar.js *@
    <button type="button" class="sidebar-reveal" data-sidebar-toggle aria-controls="site-sidebar" aria-expanded="true" title="サイドバーを表示">
        <span aria-hidden="true">☰</span><span class="visually-hidden">サイドバーを表示</span>
    </button>

    <main id="main-content" tabindex="-1">
        @* サイト内検索（すべてのページ）。候補の表示は wwwroot/js/quicksearch.js。JS がなくても /search へ送信できる *@
        <header class="site-header px-4">
            <form action="/search" method="get" role="search" class="quick-search" id="quick-search">
                <i class="bi bi-search quick-search-icon" aria-hidden="true"></i>
                <input id="quick-search-input" name="q" type="search" class="form-control" placeholder="検索（例: 押し出し、Ctrl+R、ウェイト）"
                       autocomplete="off" aria-label="サイト内を検索" role="combobox" aria-expanded="false" aria-controls="quick-search-list" aria-autocomplete="list" />
                <span class="quick-search-hint" aria-hidden="true"><kbd>Ctrl</kbd><kbd>K</kbd></span>
                <div id="quick-search-list" class="quick-search-list" role="listbox" aria-label="検索の候補" hidden></div>
            </form>
        </header>

        <article class="content px-4">
            @Body
        </article>

        <footer class="site-footer px-4">
            <span>対象バージョン: Blender @Site.Value.BlenderVersion / Unity @Site.Value.UnityVersion（VRChat SDK3）</span>
            @if (!string.IsNullOrEmpty(Site.Value.RepositoryUrl))
            {
                <span> · </span>
                <a href="@Site.Value.RepositoryUrl" target="_blank" rel="noopener">GitHub で修正を提案する</a>
            }
        </footer>
    </main>
</div>
