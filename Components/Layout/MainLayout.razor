@inherits LayoutComponentBase
@inject IOptions<SiteOptions> Site
@inject NavigationManager Nav

@* <base href="/"> があるので、# だけの href はトップへ飛んでしまう。いまのパスを付ける *@
<a class="skip-link" href="@(new Uri(Nav.Uri).AbsolutePath)#main-content">本文へスキップ <kbd>Enter</kbd></a>

<div class="page">
    @* PC の上に固定するヘッダー（ハンバーガーとサイト名）。ハンバーガーを押すたびに、サイドバーの表示・非表示を切り替える（処理は wwwroot/js/sidebar.js）。
       スマホは、サイドバー上部のサイト名とメニューのボタンを使う。キーボードで最初に届くよう、サイドバーの前に置く *@
    <header class="app-header">
        <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-controls="site-sidebar" aria-expanded="true" aria-label="サイドバーの表示・非表示" title="サイドバーの表示・非表示"></button>
        <a class="app-brand" href="/">@Site.Value.Title</a>
        @* 検索欄とライト・ダークのスイッチ（ヘッダーの右側）。スマホは、本文の上の検索欄と、サイドバー下のボタンを使う *@
        <QuickSearch IdPrefix="hdr" />
        <ThemeSwitch />
    </header>

    @* 隠しているとき（PC）は、アイコンだけの細い列になる。マウスを乗せている間は、広げて出す（CSS の :hover）。ハンバーガーを押すと、広げたままにする *@
    <div class="sidebar" id="site-sidebar">
        <div class="sidebar-panel">
            <NavMenu />
        </div>
    </div>

    <main id="main-content" tabindex="-1">
        @* サイト内検索（すべてのページ）。候補の表示は wwwroot/js/quicksearch.js。JS がなくても /search へ送信できる *@
        <header class="site-header px-4">
            <QuickSearch IdPrefix="qs" />
        </header>

        <article class="content px-4">
            @Body
        </article>

        <footer class="site-footer px-4">
            <span>対象バージョン: Blender @Site.Value.BlenderVersion / Unity @Site.Value.UnityVersion（VRChat SDK3）</span>
            @if (!string.IsNullOrEmpty(Site.Value.RepositoryUrl))
            {
                <span> · </span>
                <a href="@Site.Value.RepositoryUrl" target="_blank" rel="noopener">GitHub で修正を提案する</a>
            }
        </footer>
    </main>
</div>
