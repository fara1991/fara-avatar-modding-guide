@inject ContentService Content
@inject IOptions<SiteOptions> Site

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">@Site.Value.Title</a>
    </div>
</div>

@* 静的 SSR なので JS を使わず、チェックボックスと CSS でメニューを開閉する *@
<input type="checkbox" id="nav-toggle" class="navbar-toggler" title="ナビゲーションメニュー" />

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-house-door" aria-hidden="true"></i> ホーム
            </NavLink>
        </div>

        <div class="nav-section px-3">学習ロードマップ</div>
        @foreach (var category in Content.Categories)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"/learn/{category.Id}")">
                    <i class="bi @category.Icon" aria-hidden="true"></i> @category.Title
                </NavLink>
            </div>
        }

        <div class="nav-section px-3">リファレンス</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/shortcuts">
                <i class="bi bi-keyboard" aria-hidden="true"></i> ショートカット一覧
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/addons">
                <i class="bi bi-puzzle" aria-hidden="true"></i> アドオン
            </NavLink>
        </div>
    </nav>
</div>
