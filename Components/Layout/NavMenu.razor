@inject ContentService Content
@inject IOptions<SiteOptions> Site

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">@Site.Value.Title</a>
    </div>
</div>

@* 静的 SSR なので JS を使わず、チェックボックスと CSS でメニューを開閉する *@
<input type="checkbox" id="nav-toggle" class="navbar-toggler" title="ナビゲーションメニュー" />

<div class="nav-scrollable">
    <nav class="flex-column pt-2">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-house-door" aria-hidden="true"></i> ホーム
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/learn" Match="NavLinkMatch.All">
                <i class="bi bi-list-ol" aria-hidden="true"></i> 目次
            </NavLink>
        </div>

        @* 目次の区切りごと。まだカテゴリのない区切りは出さない *@
        @foreach (var section in Content.Sections)
        {
            var categories = Content.GetCategoriesInSection(section.Id);
            if (categories.Count == 0) continue;
            <div class="nav-section px-3">@section.Title</div>
            @foreach (var category in categories)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@($"/learn/{category.Id}")">
                        <i class="bi @category.Icon" aria-hidden="true"></i> @category.Title
                        @{ var ids = Content.GetArticles(category.Id).Select(a => a.Id).ToList(); }
                        @if (ids.Count > 0)
                        {
                            <span class="category-progress ms-auto" data-category-progress="@category.Id" data-articles="@string.Join(' ', ids)" hidden></span>
                        }
                    </NavLink>
                </div>
            }
        }

        <div class="nav-section px-3">リファレンス</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/shortcuts">
                <i class="bi bi-keyboard" aria-hidden="true"></i> ショートカット一覧
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/glossary">
                <i class="bi bi-journal-text" aria-hidden="true"></i> 用語集
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/howto">
                <i class="bi bi-question-circle" aria-hidden="true"></i> 何て名前？
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/tips">
                <i class="bi bi-lightbulb" aria-hidden="true"></i> TIPS
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/qa">
                <i class="bi bi-chat-left-text" aria-hidden="true"></i> 改変 Q&amp;A
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/addons">
                <i class="bi bi-puzzle" aria-hidden="true"></i> アドオン
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/links">
                <i class="bi bi-link-45deg" aria-hidden="true"></i> リンク集
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/changelog">
                <i class="bi bi-clock-history" aria-hidden="true"></i> 更新履歴
            </NavLink>
        </div>

        <div class="nav-section px-3">練習</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/practice" Match="NavLinkMatch.All">
                <i class="bi bi-controller" aria-hidden="true"></i> 操作の練習
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/practice/unity">
                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Unity の練習
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/practice/room">
                <i class="bi bi-people" aria-hidden="true"></i> みんなで練習
            </NavLink>
        </div>
    </nav>
    <div class="px-3 pb-3 sidebar-theme">
        <button type="button" id="theme-toggle" class="btn btn-sm btn-outline-light w-100" onclick="faraToggleTheme()">☀ ライトモード</button>
    </div>
</div>
