@* 3 サイト共通の形のフッター: サイト名 | 問い合わせ | プライバシーポリシー | © 公開年 Fara（Fara は作者のホームページへ）。
   © の横に SNS のアイコン（appsettings.json の Site:Socials。Url が空のものは出さない）。
   「問い合わせ」には、いま見ているページを ?from= で付ける（問い合わせに、どのページかが分かるように） *@
@inject IOptions<SiteOptions> Site
@inject NavigationManager Nav

<footer class="site-footer px-4">
    <div class="site-footer-line">
        <span class="site-footer-name">@Site.Value.Title</span>
        <span class="site-footer-sep" aria-hidden="true">|</span>
        <a href="@ReportHref">問い合わせ</a>
        <span class="site-footer-sep" aria-hidden="true">|</span>
        <a href="/privacy">プライバシーポリシー</a>
        <span class="site-footer-sep" aria-hidden="true">|</span>
        <span>© @Site.Value.PublishedYear <a href="@Site.Value.PortfolioUrl">Fara</a></span>
        @{ var socials = Site.Value.Socials.Where(s => !string.IsNullOrEmpty(s.Url)).ToList(); }
        @if (socials.Count > 0)
        {
            <span class="footer-socials">
                @foreach (var s in socials)
                {
                    <a class="service-@s.Service" href="@s.Url" target="_blank" rel="noopener noreferrer" aria-label="@s.Label" title="@s.Label">
                        <Icon Name="@s.Service" Size="16" />
                    </a>
                }
            </span>
        }
    </div>
</footer>

@code {
    /// <summary>問い合わせページへのリンク。問い合わせページ・プライバシーポリシーからは ?from= を付けない。</summary>
    private string ReportHref
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath;
            return SiteFooterLinks.ReportHref(path);
        }
    }
}
