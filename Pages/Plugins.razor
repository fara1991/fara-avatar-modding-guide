@page "/plugins"
@using FaraBlenderManual.Data
@inject BlenderDataService DataService

<PageTitle>プラグイン - Fara Blender Manual</PageTitle>

<h1>おすすめプラグイン</h1>
<p class="lead">Blenderの機能を拡張する便利なアドオンを紹介します。</p>

<div class="row">
    @foreach (var plugin in plugins)
    {
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title">@plugin.Name</h5>
                        <span class="badge @GetTypeBadgeClass(plugin.Type)">@plugin.Type</span>
                    </div>
                    <p class="card-text">@plugin.Description</p>
                    <div class="mb-3">
                        <strong>機能:</strong>
                        <ul class="mt-2">
                            @foreach (var feature in plugin.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">価格: @plugin.Price</small>
                        @if (!string.IsNullOrEmpty(plugin.Url))
                        {
                            <a href="@plugin.Url" target="_blank" class="btn btn-primary btn-sm">詳細を��る</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="alert alert-info mt-4" role="alert">
    <h4 class="alert-heading">プラグインのインストール方法</h4>
    <ol>
        <li>Edit > Preferences を開く</li>
        <li>Add-ons タブを選択</li>
        <li>Install... ボタンをクリック</li>
        <li>ダウンロードした.zipファイルを選択</li>
        <li>プラグインを有効化</li>
    </ol>
</div>

@code {
    private List<BlenderPlugin> plugins = new();

    protected override void OnInitialized()
    {
        plugins = DataService.GetBlenderPlugins();
    }

    private string GetTypeBadgeClass(string type)
    {
        return type switch
        {
            "モデリング" => "bg-success",
            "アニメーション" => "bg-primary",
            "レンダリング" => "bg-warning",
            "ユーティリティ" => "bg-info",
            "ゲーム開発" => "bg-secondary",
            _ => "bg-dark"
        };
    }
}
