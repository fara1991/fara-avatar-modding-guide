@page "/operations"
@using FaraBlenderManual.Data
@inject BlenderDataService DataService

<PageTitle>操作方法 - Fara Blender Manual</PageTitle>

<h1>操作方法</h1>
<p class="lead">Blenderの基本操作から応用テクニックまで段階的に学習できます。</p>

<div class="row">
    @foreach (var operation in operations)
    {
        <div class="col-lg-6 col-xl-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@operation.Title</h5>
                    <p class="card-text">@operation.Description</p>
                    <div class="mb-3">
                        <span class="badge @GetDifficultyBadgeClass(operation.Difficulty)">@operation.Difficulty</span>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-primary btn-sm" @onclick="() => ShowOperationDetail(operation)">詳細を見る</button>
                </div>
            </div>
        </div>
    }
</div>

@if (selectedOperation != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@selectedOperation.Title</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <p>@selectedOperation.Description</p>
                    <h6>手順:</h6>
                    <ol>
                        @foreach (var step in selectedOperation.Steps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">閉じる</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BlenderOperation> operations = new();
    private BlenderOperation? selectedOperation;

    protected override void OnInitialized()
    {
        operations = DataService.GetBlenderOperations();
    }

    private string GetDifficultyBadgeClass(string difficulty)
    {
        return difficulty switch
        {
            "初級" => "bg-success",
            "中級" => "bg-warning",
            "上級" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private void ShowOperationDetail(BlenderOperation operation)
    {
        selectedOperation = operation;
    }

    private void CloseModal()
    {
        selectedOperation = null;
    }
}
