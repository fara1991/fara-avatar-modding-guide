@page "/shortcuts"
@using FaraBlenderManual.Data
@inject BlenderDataService DataService

<PageTitle>ショートカット一覧 - Fara Blender Manual</PageTitle>

<h1>ショートカット一覧</h1>
<p class="lead">Blenderでよく使用されるキーボードショートカットを機能別に整理しました。</p>

<div class="mb-3">
    <div class="btn-group" role="group">
        <button type="button" class="btn @(selectedCategory == "すべて" ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByCategory(\"す��て\")">すべて</button>
        @foreach (var category in categories)
        {
            <button type="button" class="btn @(selectedCategory == category ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByCategory(category)">@category</button>
        }
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ショートカット</th>
                <th>機能</th>
                <th>カテゴリ</th>
                <th>説明</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var shortcut in filteredShortcuts)
            {
                <tr>
                    <td><kbd>@shortcut.Key</kbd></td>
                    <td>@shortcut.Function</td>
                    <td><span class="badge @GetCategoryBadgeClass(shortcut.Category)">@shortcut.Category</span></td>
                    <td>@shortcut.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<BlenderShortcut> shortcuts = new();
    private List<BlenderShortcut> filteredShortcuts = new();
    private List<string> categories = new();
    private string selectedCategory = "すべて";

    protected override void OnInitialized()
    {
        shortcuts = DataService.GetBlenderShortcuts();
        categories = shortcuts.Select(s => s.Category).Distinct().ToList();
        filteredShortcuts = shortcuts;
    }

    private void FilterByCategory(string category)
    {
        selectedCategory = category;
        filteredShortcuts = category == "すべて" 
            ? shortcuts 
            : shortcuts.Where(s => s.Category == category).ToList();
    }

    private string GetCategoryBadgeClass(string category)
    {
        return category switch
        {
            "一般" => "bg-primary",
            "モデリング" => "bg-success",
            "編集" => "bg-warning",
            "表示" => "bg-info",
            "選択" => "bg-secondary",
            _ => "bg-dark"
        };
    }
}
