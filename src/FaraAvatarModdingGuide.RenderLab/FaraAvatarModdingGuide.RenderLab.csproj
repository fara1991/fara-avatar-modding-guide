<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    レンダーラボ(Phase 3b の S2。docs/phase3b-design.md の §11)。練習の 3D を C#(Practice の操作 + Render の描画の命令)と薄い WebGL 層(wwwroot/js/gl.js)で動かす最小の画面。
    Web と同じ設定(net10.0・InvariantGlobalization・事前圧縮なし・同じパッケージの版)で作るので、読み込みの量・起動の時間・フレームの時間が、実際のサイトに載せたときの見積もりになる。
    サイトには載せない(Web からは参照しない)。確認用のサーバー(tools/verify/gl-serve.mjs)が /lab/ に出す。S3 でこの中身を /practice のページに移す。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FaraAvatarModdingGuide.RenderLab</RootNamespace>
    <!-- [JSImport] の生成コードに要る -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CompressionEnabled>false</CompressionEnabled>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaraAvatarModdingGuide.Render\FaraAvatarModdingGuide.Render.csproj" />
  </ItemGroup>

</Project>
