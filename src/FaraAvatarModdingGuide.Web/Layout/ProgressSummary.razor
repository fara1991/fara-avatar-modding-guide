@inherits ProgressAware
@inject ContentStore Store
@inject IJSRuntime JS
@* 完了したページの件数と「次に読む」リンク。静的 HTML（Build の Fragments.ProgressSummary）と同じ構造。中身は ProgressStore（localStorage）から *@
@{
    var ids = Store.Content?.ArticleIds() ?? [];
    var done = Progress.CountDone(ids);
    var nextId = ids.FirstOrDefault(id => !Progress.IsDone(id));
    var next = nextId is null ? null : Store.Content?.Articles.FirstOrDefault(a => a.Id == nextId);
}
<div class="progress-summary card mb-4" hidden="@(HideWhenEmpty && done == 0)">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div class="flex-grow-1">
            <div class="fw-semibold"><AvIcon Name="TaskAlt" Class="me-1" /><span>@ids.Count 記事のうち @done 記事を読みました</span></div>
            <div class="progress-track mt-2" aria-hidden="true"><span style="@($"width: {(ids.Count == 0 ? 0 : done * 100.0 / ids.Count).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%")"></span></div>
        </div>
        @if (next is not null)
        {
            <a class="btn btn-primary" href="/learn/@next.Id">次に読む: <span>@next.Title</span> <AvIcon Name="ArrowForward" /></a>
        }
        @if (ShowReset)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetAsync"><AvIcon Name="RestartAlt" /> 「読んだ」の印を消す</button>
        }
    </div>
    @if (ShowNote)
    {
        <div class="card-footer small text-body-secondary">@ProgressNote</div>
    }
</div>

@code {
    /// <summary>まだ 1 ページも完了していなければ表示しない。</summary>
    [Parameter] public bool HideWhenEmpty { get; set; }
    [Parameter] public bool ShowReset { get; set; }
    [Parameter] public bool ShowNote { get; set; }

    /// <summary>学習の進み具合の説明。Build の Fragments.ProgressNote と同じ文（Web.Tests が確かめる）。</summary>
    internal const string ProgressNote = "各ページの最後にある「このページを『読んだ』にする」で印を付けられます（ページ内の「やってみよう」を最後まで進めても「読んだ」になります）。『読んだ』の印は、このブラウザにだけ残り、ログインは不要です。別のブラウザや端末には引き継がれません。";

    private async Task ResetAsync()
    {
        if (await JS.InvokeAsync<bool>("confirm", "「読んだ」の印をすべて消します。よろしいですか？")) Progress.Reset();
    }
}
