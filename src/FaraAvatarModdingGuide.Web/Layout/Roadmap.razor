@* 目次。区切り（Blender / Unity / VRChat / 通しで作る）ごとに、カテゴリを読む順に並べる。静的 HTML（Build の PageBodies.Roadmap）と同じ構造・class *@
@foreach (var section in Content.Sections)
{
    var categories = Content.CategoriesIn(section.Id);
    <section class="roadmap-section" id="section-@section.Id" aria-labelledby="section-title-@section.Id">
        <h3 class="roadmap-section-title" id="section-title-@section.Id">
            <AvIcon Name="@section.Icon" /> @section.Title
        </h3>
        <p class="roadmap-section-desc text-body-secondary">@section.Description</p>
        @if (categories.Count == 0)
        {
            <p><span class="badge bg-secondary">準備中</span></p>
        }
        else
        {
            <ol class="roadmap list-unstyled">
                @foreach (var (category, index) in categories.Select((c, i) => (c, i)))
                {
                    var articles = Content.ArticlesOf(category.Id);
                    <li class="roadmap-step">
                        <div class="roadmap-marker">@(index + 1)</div>
                        <div class="roadmap-body">
                            <h4 class="h5 mb-1">
                                <AvIcon Name="@category.Icon" Class="me-1" /><a href="/learn/@category.Id" class="text-decoration-none">@category.Title</a>
                            </h4>
                            <p class="text-body-secondary mb-2">@category.Description</p>
                            @if (articles.Count == 0)
                            {
                                <span class="badge bg-secondary">準備中</span>
                            }
                            else
                            {
                                <ol class="roadmap-articles">
                                    @foreach (var article in articles)
                                    {
                                        <li data-article="@article.Id">
                                            <a href="@article.Url">@article.Title</a>
                                            <DifficultyBadge Difficulty="@article.Difficulty" />
                                        </li>
                                    }
                                </ol>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public required SiteContent Content { get; set; }
}
