@page "/practice"
@implements IAsyncDisposable
@inject SiteSettings Settings
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IServiceProvider Services

<PageTitle>操作の練習 - @Settings.Title</PageTitle>

<h1>操作の練習</h1>
<TouchPracticeGuide Items="TouchItems" />
<div class="practice-pc-only">
<p class="lead">ブラウザ上の 3D ビューで、Blender と同じキー操作を試せます。下のお題を順にこなしてください。<kbd>Tab</kbd> で編集モードにも入れます。</p>
<p class="text-body-secondary small">各記事の「やってみよう」では、同じビューで 1 キーずつ案内付きで操作できます（<a href="/learn/basics/transform">移動・回転・スケール</a> など）。ここは案内なしで自由に試す場所です。何人かで同じビューを操作したいときは <a href="/practice/room">みんなで練習</a> へ。</p>
</div>

@* 本体は wwwroot/js/practice.js と viewport.js（Three.js）。ここは枠と文言だけで、3D とお題の中身は JavaScript が作る(PracticeHost が始めて、ページを離れるときに解放する)。
   JavaScript が中身を入れる要素(#practice-viewport・#practice-tasks)は、Razor では空のままにする(Blazor は、中身のない要素の子を触らない)。
   静的 HTML(Build の PageBodies.Practice)と同じ構造にする(Web.Tests が突き合わせる) *@
<div id="practice" class="row g-4 practice-pc-only">
    <div class="col-lg-8">
        @* HUD・サイドバーなどの中身は viewport.js が作る *@
        <div class="practice-viewport" id="practice-viewport" tabindex="0" aria-label="3D ビューポート">
            @if (csMode)
            {
                @* C# 版(?engine=cs)。canvas は、中身が空の #practice-gl に gl.js が入れる(Blazor が描く HUD の兄弟に外から足さない)。HUD は viewport.js の HUD_HTML と同じ構造・クラス名 *@
                <div id="practice-gl" class="practice-gl"></div>
                @if (csFailed)
                {
                    <div class="practice-hud" style="top:50%">3D ビューを表示できません。WebGL が有効なブラウザで開いてください。</div>
                }
                <div class="practice-hud">
                    <div class="vp-mode">@hud.ModeLabel</div>
                    <div class="vp-view">@hud.ViewLabel</div>
                    <div class="vp-stats" hidden="@hud.StatsHidden">
                        @foreach (var line in hud.StatsLines)
                        {
                            @line<br />
                        }
                    </div>
                </div>
                <div class="vp-tools" role="toolbar" aria-label="表示と選択モード">
                    <span class="vp-tools-edit" hidden="@hud.ToolsEditHidden">
                        @foreach (var t in hud.Tools.Where(t => t.Key is "vert" or "edge" or "face"))
                        {
                            <button type="button" data-tool="@t.Key" title="@ToolTitle(t.Key)" class="@(t.On ? "is-on" : null)" aria-pressed="@(t.On ? "true" : "false")" disabled="@t.Disabled" @onclick="() => ClickTool(t.Key)">@ToolLabel(t.Key)</button>
                        }
                    </span>
                    @foreach (var t in hud.Tools.Where(t => t.Key is "xray" or "stats" or "mirror"))
                    {
                        <button type="button" data-tool="@t.Key" title="@ToolTitle(t.Key)" class="@(t.On ? "is-on" : null)" aria-pressed="@(t.On ? "true" : "false")" disabled="@t.Disabled" @onclick="() => ClickTool(t.Key)">@ToolLabel(t.Key)</button>
                    }
                </div>
                <div class="practice-npanel" hidden="@hud.NPanelHidden">
                    <h6>アイテム</h6>
                    <div class="vp-npanel-name mb-1">@hud.NPanelName</div>
                    @foreach (var (prop, label) in new[] { ("position", "位置"), ("rotation", "回転（°）"), ("scale", "スケール") })
                    {
                        <h6>@label</h6>
                        <div class="row-3">
                            @foreach (var r in hud.NPanelRows.Where(r => r.Prop == prop))
                            {
                                <span>@r.Axis.ToUpperInvariant()</span>
                                <input type="number" step="@(prop == "rotation" ? "1" : "0.1")" data-prop="@r.Prop" data-axis="@r.Axis" value="@r.Value" disabled="@r.Disabled" @onchange="e => ChangeNPanel(r.Prop, r.Axis, e.Value?.ToString() ?? string.Empty)" />
                            }
                        </div>
                    }
                </div>
                <div class="practice-status">
                    <span class="vp-status">@hud.Status</span>
                    <span class="vp-numeric">@hud.Numeric</span>
                </div>
                @if (hud.Menu is { } menu)
                {
                    <div class="practice-menu" style="@MenuStyle(menu)">
                        <div class="title">@menu.Title</div>
                        @for (var i = 0; i < menu.Items.Count; i++)
                        {
                            var index = i;
                            <button type="button" @onclick="() => ChooseMenu(index)">@menu.Items[i]</button>
                        }
                    </div>
                }
                @if (hud.Box is { } box)
                {
                    <div class="practice-box" style="@BoxStyle(box)"></div>
                }
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
            <button type="button" class="btn btn-sm btn-outline-primary" id="practice-reset" @onclick="OnReset">最初からやり直す</button>
            <div class="form-check form-check-inline ms-2 mb-0">
                <input class="form-check-input" type="checkbox" id="practice-emulate-numpad" @bind="emulateNumpad" />
                <label class="form-check-label small" for="practice-emulate-numpad">テンキーを模倣（数字キーで視点を切り替え）</label>
            </div>
            <span class="small text-body-secondary ms-auto">ビューポートをクリックしてからキーを押してください</span>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3 practice-tasks-card">
            <div class="card-header fw-semibold">お題</div>
            <div class="card-body">
                @if (csMode)
                {
                    @* C# 版(?engine=cs): 一覧は Razor が描く(JS 版は practice.js が中身を入れるので、ここは空のまま) *@
                    <ol class="practice-tasks mb-2" id="practice-tasks">
                        @for (var i = 0; i < hud.TaskTexts.Count; i++)
                        {
                            <li class="@(hud.TaskDone[i] ? "done" : i == hud.TaskIndex ? "current" : null)">@hud.TaskTexts[i]</li>
                        }
                    </ol>
                    <div id="practice-tasks-done" class="small text-body-secondary" hidden="@(hud.TaskIndex < hud.TaskTexts.Count)">すべてできました。あとは自由に試してください。</div>
                }
                else
                {
                    <ol class="practice-tasks mb-2" id="practice-tasks"></ol>
                    <div id="practice-tasks-done" class="small text-body-secondary" hidden>すべてできました。あとは自由に試してください。</div>
                }
            </div>
        </div>
        <div class="card practice-keys">
            <div class="card-header fw-semibold">使えるキー</div>
            <div class="card-body small">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td>ホイールボタンをドラッグ</td><td>視点を回す</td></tr>
                        <tr><td><kbd>Shift</kbd>+ホイールボタン</td><td>視点を平行移動</td></tr>
                        <tr><td>ホイール</td><td>ズーム</td></tr>
                        <tr><td><kbd>Numpad 1</kbd> <kbd>3</kbd> <kbd>7</kbd></td><td>前 / 右 / 上から（<kbd>Ctrl</kbd> で反対側）</td></tr>
                        <tr><td><kbd>Numpad 5</kbd></td><td>透視 / 平行投影</td></tr>
                        <tr><td><kbd>Numpad .</kbd> / <kbd>Home</kbd></td><td>選択を表示 / 全体を表示</td></tr>
                        <tr><td>クリック / <kbd>Shift</kbd>+クリック / ドラッグ</td><td>選択 / 追加選択 / ボックス選択</td></tr>
                        <tr><td><kbd>A</kbd> / <kbd>Alt</kbd>+<kbd>A</kbd></td><td>全選択 / 選択解除</td></tr>
                        <tr><td><kbd>G</kbd> <kbd>R</kbd> <kbd>S</kbd></td><td>移動 / 回転 / スケール（<kbd>X</kbd> <kbd>Y</kbd> <kbd>Z</kbd> で軸固定、数値入力可）</td></tr>
                        <tr><td><kbd>Ctrl</kbd> / <kbd>Shift</kbd>（操作中）</td><td>スナップ / 微調整</td></tr>
                        <tr><td>左クリック / <kbd>Enter</kbd></td><td>確定</td></tr>
                        <tr><td>右クリック / <kbd>Esc</kbd></td><td>キャンセル</td></tr>
                        <tr><td><kbd>Shift</kbd>+<kbd>A</kbd></td><td>追加</td></tr>
                        <tr><td><kbd>Shift</kbd>+<kbd>D</kbd></td><td>複製</td></tr>
                        <tr><td><kbd>X</kbd> / <kbd>Delete</kbd></td><td>削除</td></tr>
                        <tr><td><kbd>N</kbd></td><td>サイドバー（位置・回転・スケール）</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>Z</kbd> / <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd></td><td>元に戻す / やり直し</td></tr>
                        <tr><td><kbd>Alt</kbd>+<kbd>Z</kbd></td><td>透過表示</td></tr>
                        <tr class="table-group-divider"><th colspan="2">編集モード</th></tr>
                        <tr><td><kbd>Tab</kbd></td><td>編集モードの出入り</td></tr>
                        <tr><td><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd></td><td>頂点 / 辺 / 面の選択モード</td></tr>
                        <tr><td><kbd>Alt</kbd>+クリック / <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+クリック</td><td>ループ / リング選択</td></tr>
                        <tr><td><kbd>L</kbd> / <kbd>Ctrl</kbd>+<kbd>L</kbd></td><td>つながった部分を選択</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>I</kbd></td><td>選択を反転</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>Numpad +</kbd> / <kbd>-</kbd></td><td>選択を広げる / 狭める</td></tr>
                        <tr><td><kbd>E</kbd> / <kbd>I</kbd></td><td>押し出し / 差し込み</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>R</kbd></td><td>ループカット（ホイールで本数、右クリックで中央）</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>B</kbd></td><td>ベベル（分割数 1 のみ）</td></tr>
                        <tr><td><kbd>X</kbd></td><td>削除（頂点 / 辺 / 面 / 辺を溶解）</td></tr>
                        <tr><td><kbd>M</kbd> / <kbd>F</kbd> / <kbd>P</kbd></td><td>マージ / 面を張る / 分離</td></tr>
                        <tr><td>上のボタン</td><td>透過・統計・ミラー（X 方向）の表示</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private PracticeHost? host;
    private IPracticeCs? cs;
    private PracticeHud hud = new();
    private bool csMode;
    private bool emulateNumpad;
    private bool csFailed;
    private bool disposed;
    private static Task? lazyLoading;

    protected override void OnInitialized()
    {
        // 同じページのまま ?engine= だけが変わる移動（アドレスの書き換え・戻る）は、ページを読み込み直す（エンジンの切り替えは、始め直しが要るため）
        Nav.LocationChanged += OnLocationChanged;
        // ?engine=cs で、3D を C#(Practice・Render)+ 薄い WebGL 層で動かす(Phase 3b S3。既定は今までの Three.js 版)。?debug=1 で、確認用の状態(window.__practice)を出す
        csMode = Query("engine") == "cs";
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (disposed || !new Uri(e.Location).AbsolutePath.TrimEnd('/').EndsWith("/practice", StringComparison.Ordinal)) return;
        var wantCs = Query("engine") == "cs";
        if (wantCs != csMode) Nav.NavigateTo(e.Location, forceLoad: true);
    }

    private string? Query(string name)
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            if (kv[0] == name) return kv.Length == 2 ? Uri.UnescapeDataString(kv[1]) : "";
        }
        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        host = new PracticeHost(JS);
        if (csMode)
        {
            // タッチだけの端末は、案内の画面(JS 版の入口)にする
            if (!await host.IsTouchOnlyAsync())
            {
                await StartCsAsync();
                return;
            }
            csMode = false;
            StateHasChanged();
        }
        await host.StartAsync("practice.js", "");
    }

    /// <summary>Practice・Render の読み込みは、ページを離れて戻る（読み込み中に別のページが同じ読み込みを始める）ことがあるので、1 回だけ・全員で共有する（同じ wasm を二重に読むと、本文の読み込みが衝突する）。</summary>
    private Task LoadLazyAssembliesAsync()
    {
        lazyLoading ??= Services.GetRequiredService<Microsoft.AspNetCore.Components.WebAssembly.Services.LazyAssemblyLoader>()
            .LoadAssembliesAsync(["FaraAvatarModdingGuide.Practice.wasm", "FaraAvatarModdingGuide.Render.wasm"]);
        return lazyLoading;
    }

    private async Task StartCsAsync()
    {
        IPracticeCs? created = null;
        try
        {
            // 操作のロジックと描画の命令（Practice・Render）は、?engine=cs のときだけ読み込む（通常のページの読み込みを増やさない）
            try { await LoadLazyAssembliesAsync(); }
            catch { lazyLoading = null; throw; }   // 失敗したら、次に開いたときにやり直せるように
            if (disposed) return;                    // 読み込んでいるあいだにページを離れた
            created = await PracticeCsLoader.CreateAsync(() => emulateNumpad, Query("debug") == "1");
            if (disposed) return;                    // finally で created を解放する
            cs = created;
            cs.Changed += OnCsChanged;
            created = null;
            if (!cs.Start())
            {
                csFailed = true;
                Console.Error.WriteLine("[avatar] WebGL 2 が使えません");
            }
            hud = cs.Hud;
        }
        catch (Exception e)
        {
            csFailed = true;
            Console.Error.WriteLine($"[avatar] 練習（C# 版）を始められません: {e.Message}");
        }
        finally
        {
            created?.Dispose();
        }
        if (!disposed) StateHasChanged();
    }

    private void OnCsChanged()
    {
        if (cs is null) return;
        hud = cs.Hud;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnReset() => cs?.Reset();

    private void ClickTool(string tool) => cs?.ClickTool(tool);

    private void ChooseMenu(int index) => cs?.ChooseMenu(index);

    private void ChangeNPanel(string prop, string axis, string value) => cs?.ChangeNPanel(prop, axis, value);

    private static string ToolLabel(string key) => key switch { "vert" => "頂点", "edge" => "辺", "face" => "面", "xray" => "透過", "stats" => "統計", _ => "ミラー" };

    private static string ToolTitle(string key) => key switch
    {
        "vert" => "頂点選択（1）", "edge" => "辺選択（2）", "face" => "面選択（3）", "xray" => "透過表示（Alt+Z）", "stats" => "オーバーレイ > 統計", _ => "ミラー モディファイアー（X 方向）",
    };

    private static string Px(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    /// <summary>ビューからはみ出さないように(viewport.js の showMenu の補正。メニューの大きさは項目の数からの見積もり)。</summary>
    private static string MenuStyle(HudMenu m) =>
        $"left:max(0px, min({Px(m.X)}, calc(100% - 184px)));top:max(0px, min({Px(m.Y)}, calc(100% - {Px(30 + 26 * (m.Items.Count + 1))})))";

    private static string BoxStyle(HudBox b) => $"left:{Px(b.X)};top:{Px(b.Y)};width:{Px(b.Width)};height:{Px(b.Height)}";

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        if (cs is not null)
        {
            cs.Changed -= OnCsChanged;
            cs.Dispose();
            cs = null;
        }
        if (host is not null) await host.DisposeAsync();
    }

    // スマートフォン用: 練習のお題に対応する記事内チュートリアル（画像で見る）
    private static readonly IReadOnlyList<TouchPracticeGuide.Item> TouchItems =
    [
        new("navigation-mouse", "マウスで視点を動かす", "/learn/getting-started/navigation"),
        new("select", "選択・追加・削除・複製", "/learn/basics/select"),
        new("transform", "移動・回転・スケール", "/learn/basics/transform"),
        new("edit-mode", "編集モードの選択", "/learn/modeling/edit-mode"),
        new("extrude-inset-loopcut", "押し出し・差し込み・ループカット", "/learn/modeling/extrude-inset-loopcut"),
        new("bevel-merge", "ベベル・マージ・面を張る", "/learn/modeling/bevel-knife-merge"),
    ];
}
