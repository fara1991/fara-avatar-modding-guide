@page "/practice"
@implements IAsyncDisposable
@inject SiteSettings Settings
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IServiceProvider Services

<PageTitle>@PageTitles.Compose("操作の練習", Settings.Title)</PageTitle>

<h1>操作の練習</h1>
<TouchPracticeGuide Items="TouchItems" />
<div class="practice-pc-only">
<p class="lead">ブラウザ上の 3D ビューで、Blender と同じキー操作を試せます。下のお題を順にこなしてください。<kbd>Tab</kbd> で編集モードにも入れます。</p>
<p class="text-body-secondary small">各記事の「やってみよう」では、同じビューで 1 キーずつ案内付きで操作できます（<a href="/learn/basics/transform">移動・回転・スケール</a> など）。ここは案内なしで自由に試す場所です。何人かで同じビューを操作したいときは <a href="/practice/room">みんなで練習</a> へ。Unity の画面（Modular Avatar で衣装を着せる流れ）の練習は <a href="/practice/unity">Unity の練習</a> へ。</p>
</div>

@* 3D（Practice・Render。C#）と HUD・お題の一覧は Razor が描く（Phase 3b S3・S7。three.js は使わない）。静的 HTML（Build の PageBodies.Practice）と同じ構造にする（Web.Tests が突き合わせる） *@
<div id="practice" class="row g-4 practice-pc-only">
    <div class="col-lg-8">
        <div class="practice-viewport" id="practice-viewport" tabindex="0" aria-label="3D ビューポート">
            @* HUD は viewport.js の HUD_HTML と同じ構造・クラス名（PracticeHudView） *@
            @if (cs is not null)
            {
                <PracticeHudView Hud="hud" GlHostId="practice-gl" RootId="practice-viewport" Failed="csFailed" OnTool="ClickTool" OnMenu="ChooseMenu" OnNPanel="OnNPanel" />
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
            <button type="button" class="btn btn-sm btn-outline-primary" id="practice-reset" @onclick="OnReset">最初からやり直す</button>
            <div class="form-check form-check-inline ms-2 mb-0">
                <input class="form-check-input" type="checkbox" id="practice-emulate-numpad" @bind="emulateNumpad" />
                <label class="form-check-label small" for="practice-emulate-numpad">テンキーを模倣（数字キーで視点を切り替え）</label>
            </div>
            <span class="small text-body-secondary ms-auto">ビューポートをクリックしてからキーを押してください</span>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3 practice-tasks-card">
            <div class="card-header fw-semibold">お題</div>
            <div class="card-body">
                @if (cs is not null)
                {
                    <ol class="practice-tasks mb-2" id="practice-tasks">
                        @for (var i = 0; i < hud.TaskTexts.Count; i++)
                        {
                            <li class="@(hud.TaskDone[i] ? "done" : i == hud.TaskIndex ? "current" : null)">@hud.TaskTexts[i]</li>
                        }
                    </ol>
                    <div id="practice-tasks-done" class="small text-body-secondary" hidden="@(hud.TaskIndex < hud.TaskTexts.Count)">すべてできました。あとは自由に試してください。</div>
                }
                else
                {
                    @* 3D（C#）が始まる前・タッチだけの端末は、静的 HTML（PageBodies.Practice）と同じ空の一覧 *@
                    <ol class="practice-tasks mb-2" id="practice-tasks"></ol>
                    <div id="practice-tasks-done" class="small text-body-secondary" hidden>すべてできました。あとは自由に試してください。</div>
                }
            </div>
        </div>
        <div class="card practice-keys">
            <div class="card-header fw-semibold">使えるキー</div>
            <div class="card-body small">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td>ホイールボタンをドラッグ</td><td>視点を回す</td></tr>
                        <tr><td><kbd>Shift</kbd>+ホイールボタン</td><td>視点を平行移動</td></tr>
                        <tr><td>ホイール</td><td>ズーム</td></tr>
                        <tr><td><kbd>Numpad 1</kbd> <kbd>3</kbd> <kbd>7</kbd></td><td>前 / 右 / 上から（<kbd>Ctrl</kbd> で反対側）</td></tr>
                        <tr><td><kbd>Numpad 5</kbd></td><td>透視 / 平行投影</td></tr>
                        <tr><td><kbd>Numpad .</kbd> / <kbd>Home</kbd></td><td>選択を表示 / 全体を表示</td></tr>
                        <tr><td>クリック / <kbd>Shift</kbd>+クリック / ドラッグ</td><td>選択 / 追加選択 / ボックス選択</td></tr>
                        <tr><td><kbd>A</kbd> / <kbd>Alt</kbd>+<kbd>A</kbd></td><td>全選択 / 選択解除</td></tr>
                        <tr><td><kbd>G</kbd> <kbd>R</kbd> <kbd>S</kbd></td><td>移動 / 回転 / スケール（<kbd>X</kbd> <kbd>Y</kbd> <kbd>Z</kbd> で軸固定、数値入力可）</td></tr>
                        <tr><td><kbd>Ctrl</kbd> / <kbd>Shift</kbd>（操作中）</td><td>スナップ / 微調整</td></tr>
                        <tr><td>左クリック / <kbd>Enter</kbd></td><td>確定</td></tr>
                        <tr><td>右クリック / <kbd>Esc</kbd></td><td>キャンセル</td></tr>
                        <tr><td><kbd>Shift</kbd>+<kbd>A</kbd></td><td>追加</td></tr>
                        <tr><td><kbd>Shift</kbd>+<kbd>D</kbd></td><td>複製</td></tr>
                        <tr><td><kbd>X</kbd> / <kbd>Delete</kbd></td><td>削除</td></tr>
                        <tr><td><kbd>N</kbd></td><td>サイドバー（位置・回転・スケール）</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>Z</kbd> / <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd></td><td>元に戻す / やり直し</td></tr>
                        <tr><td><kbd>Alt</kbd>+<kbd>Z</kbd></td><td>透過表示</td></tr>
                        <tr class="table-group-divider"><th colspan="2">編集モード</th></tr>
                        <tr><td><kbd>Tab</kbd></td><td>編集モードの出入り</td></tr>
                        <tr><td><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd></td><td>頂点 / 辺 / 面の選択モード</td></tr>
                        <tr><td><kbd>Alt</kbd>+クリック / <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+クリック</td><td>ループ / リング選択</td></tr>
                        <tr><td><kbd>L</kbd> / <kbd>Ctrl</kbd>+<kbd>L</kbd></td><td>つながった部分を選択</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>I</kbd></td><td>選択を反転</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>Numpad +</kbd> / <kbd>-</kbd></td><td>選択を広げる / 狭める</td></tr>
                        <tr><td><kbd>E</kbd> / <kbd>I</kbd></td><td>押し出し / 差し込み</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>R</kbd></td><td>ループカット（ホイールで本数、右クリックで中央）</td></tr>
                        <tr><td><kbd>Ctrl</kbd>+<kbd>B</kbd></td><td>ベベル（分割数 1 のみ）</td></tr>
                        <tr><td><kbd>X</kbd></td><td>削除（頂点 / 辺 / 面 / 辺を溶解）</td></tr>
                        <tr><td><kbd>M</kbd> / <kbd>F</kbd> / <kbd>P</kbd></td><td>マージ / 面を張る / 分離</td></tr>
                        <tr><td>上のボタン</td><td>透過・統計・ミラー（X 方向）の表示</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private PracticeHost? host;
    private IPracticeCs? cs;
    private PracticeHud hud = new();
    private bool emulateNumpad;
    private bool csFailed;
    private bool disposed;

    private string? Query(string name) => Nav.Get(name);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        host = new PracticeHost(JS);
        // タッチだけの端末は、案内の画面（記事内チュートリアルの「画像で見る」）。PC は C# 版の 3D
        if (!await host.IsTouchOnlyAsync())
        {
            await StartCsAsync();
            return;
        }
        await host.StartGuideAsync();
    }

    private async Task StartCsAsync()
    {
        IPracticeCs? created = null;
        try
        {
            // 操作のロジックと描画の命令（Practice・Render）は、PC の練習を始めるときに遅れて読み込む（通常のページの読み込みを増やさない）
            await PracticeCsAssemblies.LoadAsync(Services);
            if (disposed) return;                    // 読み込んでいるあいだにページを離れた
            created = await PracticeCsLoader.CreateAsync(() => emulateNumpad, Query("debug") == "1");
            if (disposed) return;                    // finally で created を解放する
            cs = created;
            cs.Changed += OnCsChanged;
            created = null;
            if (!cs.Start())
            {
                csFailed = true;
                Console.Error.WriteLine("[avatar] WebGL 2 が使えません");
            }
            hud = cs.Hud;
        }
        catch (Exception e)
        {
            csFailed = true;
            Console.Error.WriteLine($"[avatar] 練習（C# 版）を始められません: {e.Message}");
        }
        finally
        {
            created?.Dispose();
        }
        if (!disposed) StateHasChanged();
    }

    private void OnCsChanged()
    {
        if (cs is null) return;
        hud = cs.Hud;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnReset() => cs?.Reset();

    private void ClickTool(string tool) => cs?.ClickTool(tool);

    private void ChooseMenu(int index) => cs?.ChooseMenu(index);

    private void ChangeNPanel(string prop, string axis, string value) => cs?.ChangeNPanel(prop, axis, value);

    private void OnNPanel((string Prop, string Axis, string Value) a) => ChangeNPanel(a.Prop, a.Axis, a.Value);

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (cs is not null)
        {
            cs.Changed -= OnCsChanged;
            cs.Dispose();
            cs = null;
        }
        if (host is not null) await host.DisposeAsync();
    }

    // スマートフォン用: 練習のお題に対応する記事内チュートリアル（画像で見る）
    private static readonly IReadOnlyList<TouchPracticeGuide.Item> TouchItems =
    [
        new("navigation-mouse", "マウスで視点を動かす", "/learn/getting-started/navigation"),
        new("select", "選択・追加・削除・複製", "/learn/basics/select"),
        new("transform", "移動・回転・スケール", "/learn/basics/transform"),
        new("edit-mode", "編集モードの選択", "/learn/modeling/edit-mode"),
        new("extrude-inset-loopcut", "押し出し・差し込み・ループカット", "/learn/modeling/extrude-inset-loopcut"),
        new("bevel-merge", "ベベル・マージ・面を張る", "/learn/modeling/bevel-knife-merge"),
    ];
}
