@page "/addons"
@inject ContentStore Store
@inject SiteSettings Settings

<PageTitle>@PageTitles.Compose("アドオン", Settings.Title)</PageTitle>

@* 静的 HTML（Build の PageBodies.Addons）と同じ構造・class *@
<h1>おすすめアドオン</h1>
<p class="lead">Blender の機能を拡張する便利なアドオンを紹介します。Unity のツールや参考になる記事は <a href="/links">リンク集</a> へ。</p>

@if (Store.Content is not { } content)
{
    <p class="text-body-secondary" role="status">アドオンを読み込めませんでした。ページを再読み込みしてください。</p>
}
else
{
    <div class="row g-4">
        @foreach (var a in content.Addons)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h5 class="card-title mb-0">@a.Name</h5>
                            <span class="badge @SiteLookups.AddonBadgeClass(a.Type)">@a.Type</span>
                        </div>
                        @if (!string.IsNullOrEmpty(a.Status))
                        {
                            <span class="badge bg-warning text-dark mb-2"><AvIcon Name="Warning" /> @a.Status</span>
                        }
                        @if (a.Source == "discord")
                        {
                            <div class="tip-tags"><span class="tip-tag tip-source-discord" title="Discord での質問・会話で紹介されたもの"><AvIcon Name="Forum" /> Discord より</span></div>
                        }
                        <p class="card-text">@a.Description</p>
                        @if (!string.IsNullOrEmpty(a.Note))
                        {
                            <p class="card-text small text-body-secondary border-start border-3 border-warning ps-2">@a.Note</p>
                        }
                        @if (a.Features.Count > 0)
                        {
                            <ul class="mb-3">
                                @foreach (var f in a.Features)
                                {
                                    <li>@f</li>
                                }
                            </ul>
                        }
                        <div class="d-flex justify-content-between align-items-center"><small class="text-body-secondary">価格: @a.Price</small>@if (!string.IsNullOrEmpty(a.Url)) {<a href="@a.Url" target="_blank" rel="noopener" class="btn btn-primary btn-sm">公式サイト <AvIcon Name="OpenInNew" /></a>}</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="alert alert-info mt-4" role="alert">
        <h4 class="alert-heading h5">アドオンのインストール方法（Blender 4.2 以降）</h4>
        <p class="mb-2"><strong>Extensions Platform に掲載されているもの</strong>（Node Wrangler など）</p>
        <ol>
            <li>Edit &gt; Preferences を開く</li>
            <li>Get Extensions タブで名前を検索</li>
            <li>Install をクリック（自動で有効化される）</li>
        </ol>
        <p class="mb-2"><strong>.zip で配布されているもの</strong>（GitHub や Gumroad から入手したアドオン）</p>
        <ol class="mb-2">
            <li>Edit &gt; Preferences を開く</li>
            <li>Add-ons タブ右上の <kbd>∨</kbd> メニューから Install from Disk... を選択</li>
            <li>ダウンロードした .zip ファイルを選択</li>
            <li>一覧でチェックを入れて有効化</li>
        </ol>
        <p class="mb-0 small">Blender 4.1 以前は Add-ons タブの Install... ボタンから .zip を選びます。</p>
    </div>
}
