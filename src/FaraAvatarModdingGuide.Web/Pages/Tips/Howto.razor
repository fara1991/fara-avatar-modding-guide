@page "/howto"
@inherits FilterPage
@inject SiteSettings Settings

<PageTitle>あの操作、何て名前？ - @Settings.Title</PageTitle>

@* 静的 HTML（Build の PageBodies.Howto）と同じ構造・class。絞り込みの動きは FilterPage *@
<h1>あの操作、何て名前？</h1>
<p class="lead">やりたいことから、操作の名前・メニューの場所（日本語 / 英語 UI）・キーを引けます。名前がわかれば、Blender では <kbd>F3</kbd>（メニュー検索）にそのまま入力して実行できます。</p>

@if (Store.Content is not { } content)
{
    <p class="text-body-secondary" role="status">一覧を読み込めませんでした。ページを再読み込みしてください。</p>
}
else
{
    var shown = content.Howtos.Count(h => IsShown(h.Id, h.Tags, h.Source));
    <TipsFilter Tags="@SiteLookups.TipTags(content.Howtos.Select(h => h.Tags))" Placeholder="やりたいことで絞り込む（例: くっつけ、穴、揺らす）"
                HasDiscord="@content.Howtos.Any(h => h.Source == "discord")" Query="@Query" Tag="@Tag" CountText="@CountText(content.Howtos.Count, shown)"
                OnQuery="@(q => SetQuery(q))" OnTag="@(t => SetTag(t))" />
    <div class="row g-3">
        @foreach (var h in content.Howtos)
        {
            <div class="col-lg-6" data-tip-item hidden="@(!IsShown(h.Id, h.Tags, h.Source))">
                <article class="tip-card card h-100" id="@h.Id" data-tags="@string.Join('|', h.Tags)" data-source="@h.Source" data-aliases="@string.Join(' ', h.Aliases)">
                    <div class="card-body">
                        <h2 class="h5 mb-2"><a href="/howto#@h.Id" class="tip-anchor">@h.Question</a></h2>
                        <p class="howto-answer mb-2"><AvIcon Name="SubdirectoryArrowRight" /> <strong>@h.Answer</strong>@if (!string.IsNullOrEmpty(h.AnswerEn)) {<text> </text><span class="tip-en">@h.AnswerEn</span>}@foreach (var key in h.Shortcuts) {<text> </text><kbd class="ms-1">@key</kbd>}</p>
                        @if (!string.IsNullOrEmpty(h.Menu))
                        {
                            <dl class="howto-menu small mb-2"><dt>メニュー</dt><dd>@h.Menu</dd>@if (!string.IsNullOrEmpty(h.MenuEn)) {<dt>英語 UI</dt><dd>@h.MenuEn</dd>}</dl>
                        }
                        @if (!string.IsNullOrEmpty(h.NoteHtml))
                        {
                            <p class="small mb-2">@((MarkupString)h.NoteHtml)</p>
                        }
                        <TipBody Html="@h.BodyHtml" Open="@(OpenId == h.Id)" />
                        <TipTags Tags="@h.Tags" Source="@h.Source" />
                        <TipRefs Articles="@h.Articles" Related="@h.Related" Keywords="@h.Keywords" />
                    </div>
                </article>
            </div>
        }
    </div>
}

@code {
    protected override string Kind => "howto";

    protected override (IReadOnlyList<string> Tags, string Source)? Meta(string id) =>
        Store.Content?.Howtos.Where(h => h.Id == id).Select(h => ((IReadOnlyList<string> Tags, string Source)?)(h.Tags, h.Source)).FirstOrDefault();
}
