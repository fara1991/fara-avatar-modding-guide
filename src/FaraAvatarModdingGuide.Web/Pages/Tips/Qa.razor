@page "/qa"
@inherits FilterPage
@inject SiteSettings Settings

<PageTitle>@PageTitles.Compose("改変 Q&A", Settings.Title)</PageTitle>

@* 静的 HTML（Build の PageBodies.Qa）と同じ構造・class。絞り込みの動きは FilterPage *@
<h1>改変 Q&amp;A</h1>
<p class="lead">アバター改変の相談でよく出た質問と、その答え・手順をまとめました。各項目の「詳しく」を開くと手順や補足が見られます。言葉の意味は <a href="/glossary">用語集</a>、症状から探すなら <a href="/tips">TIPS</a> へ。</p>
<p class="small text-body-secondary">「当時」と書いてあるところは、古いバージョンの Blender・Unity・VRChat SDK での手順です。今の手順と一緒に載せています。</p>

@if (Store.Content is not { } content)
{
    <p class="text-body-secondary" role="status">Q&amp;A を読み込めませんでした。ページを再読み込みしてください。</p>
}
else
{
    var shown = content.Qas.Count(q => IsShown(q.Id, q.Tags, q.Source));
    <TipsFilter Tags="@SiteLookups.TipTags(content.Qas.Select(q => q.Tags))" Placeholder="質問で絞り込む（例: 首、ウェイト、VRM）"
                HasDiscord="@content.Qas.Any(q => q.Source == "discord")" Query="@Query" Tag="@Tag" CountText="@CountText(content.Qas.Count, shown)"
                OnQuery="@(q => SetQuery(q))" OnTag="@(t => SetTag(t))" />
    <div class="row g-3">
        @foreach (var q in content.Qas)
        {
            <div class="col-lg-6" data-tip-item hidden="@(!IsShown(q.Id, q.Tags, q.Source))">
                <article class="tip-card card h-100" id="@q.Id" data-tags="@string.Join('|', q.Tags)" data-source="@q.Source">
                    <div class="card-body">
                        <h2 class="h5 mb-2"><AvIcon Name="Chat" Class="me-1" /><a href="/qa#@q.Id" class="tip-anchor">@q.Question</a></h2>
                        <TipTags Tags="@q.Tags" Source="@q.Source" />
                        <p class="mb-2">@((MarkupString)q.AnswerHtml)</p>
                        <TipBody Html="@q.BodyHtml" Open="@(OpenId == q.Id)" />
                        <TipRefs Shortcuts="@q.Shortcuts" Articles="@q.Articles" Related="@q.Related" Keywords="@q.Keywords" />
                    </div>
                </article>
            </div>
        }
    </div>
}

@code {
    protected override string Kind => "qa";

    protected override (IReadOnlyList<string> Tags, string Source)? Meta(string id) =>
        Store.Content?.Qas.Where(q => q.Id == id).Select(q => ((IReadOnlyList<string> Tags, string Source)?)(q.Tags, q.Source)).FirstOrDefault();
}
