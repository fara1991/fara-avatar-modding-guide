<Project Sdk="Microsoft.NET.Sdk">

  <!--
    記事（Markdown）・データ（YAML）の読み込み、検索の索引づくり。ASP.NET にも WebAssembly にも依存しない（ビルド時専用。
    docs/wasm-migration-plan.md の 3.1）。Content/ ディレクトリのパスを渡して使う。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FaraAvatarModdingGuide</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FaraAvatarModdingGuide.Content.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
