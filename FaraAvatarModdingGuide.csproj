<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 試作（WebAssembly + MudBlazor）は本体に含めない（experiments/wasm/）。既定の取り込み（.cs・.razor・None など）からすべて外す -->
    <DefaultItemExcludes>$(DefaultItemExcludes);experiments\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- テストプロジェクト（tests/）のソースを、このプロジェクトに取り込まない -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- 試作（WebAssembly + MudBlazor）は本体に含めない（experiments/wasm/）。別のプロジェクトとしてビルドする -->
    <Compile Remove="experiments\**" />
    <EmbeddedResource Remove="experiments\**" />
    <None Remove="experiments\**" />
    <!-- .razor は Razor SDK の RazorComponent 項目として取り込まれるので、そちらからも外す -->
    <RazorComponent Remove="experiments\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 記事・ショートカット・アドオンの定義は Content/ 以下の Markdown / YAML。実行時に読み込むので出力先へコピーする -->
    <None Remove="Content\**" />
    <Content Include="Content\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
