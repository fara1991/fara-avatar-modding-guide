<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- テストプロジェクト（tests/）と、移行先の新プロジェクト（src/）・共通部品（external/）のソースを、このプロジェクトに取り込まない
         （Sdk.Web は **/*.cs を拾うので、src/ の .cs や obj/ の自動生成ファイルが混ざってビルドが壊れる） -->
    <Compile Remove="tests\**;src\**;external\**" />
    <EmbeddedResource Remove="tests\**;src\**;external\**" />
    <None Remove="tests\**;src\**;external\**" />
    <RazorComponent Remove="tests\**;src\**;external\**" />
    <Content Remove="tests\**;src\**;external\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 記事・ショートカット・アドオンの定義は Content/ 以下の Markdown / YAML。実行時に読み込むので出力先へコピーする -->
    <None Remove="Content\**" />
    <Content Include="Content\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 記事・データの読み込み（Markdig・YamlDotNet は Content プロジェクト経由） -->
    <ProjectReference Include="src\FaraAvatarModdingGuide.Content\FaraAvatarModdingGuide.Content.csproj" />
  </ItemGroup>

</Project>
