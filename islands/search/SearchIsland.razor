@* 検索ページの島（<fara-search>）。検索の判定は SearchCore（searchcore.js の移植）。 *@
@inject HttpClient Http
@inject IJSRuntime JS

@if (_failed)
{
    <p class="text-danger">検索インデックスを読み込めませんでした。</p>
}
else if (_index is null)
{
    <p class="text-body-secondary">読み込み中…</p>
}
else if (string.IsNullOrEmpty(_query))
{
    <p class="text-body-secondary">キーワードを入力してください。どのページでも <kbd>Ctrl</kbd>+<kbd>K</kbd> か <kbd>/</kbd> で上の検索欄に移動できます。</p>
}
else if (_hits.Count == 0)
{
    <p>「@_query」に一致するものは見つかりませんでした。</p>
}
else
{
    <p class="text-body-secondary">@_hits.Count 件</p>
    @foreach (var hit in _hits)
    {
        var entry = hit.Entry;
        var type = TypeOf(entry.Type);
        <a href="@entry.Url" class="search-result">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge @type.Cls">@type.Label</span>
                <span class="search-result-title">@Marks(entry.Title)</span>
                @if (!string.IsNullOrEmpty(entry.Subtitle))
                {
                    <span class="text-body-secondary small">@Marks(entry.Subtitle)</span>
                }
            </div>
            <div class="search-result-snippet">@Marks(SearchCore.Snippet(entry.Text, _query))</div>
        </a>
    }
}

@code {

    // 種類の表示（searchcore.js の TYPES と同じ）
    private static readonly Dictionary<string, (string Label, string Cls)> Types = new()
    {
        ["article"] = ("記事", "bg-primary"),
        ["glossary"] = ("用語", "bg-warning text-dark"),
        ["howto"] = ("何て名前？", "bg-danger"),
        ["tip"] = ("TIPS", "bg-info text-dark"),
        ["qa"] = ("Q&A", "bg-light text-dark"),
        ["shortcut"] = ("ショートカット", "bg-success"),
        ["addon"] = ("アドオン", "bg-secondary"),
        ["link"] = ("リンク", "bg-primary-subtle text-primary-emphasis"),
    };

    private List<SearchCore.Indexed>? _index;
    private List<SearchCore.Hit> _hits = [];
    private string _query = "";
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        // 検索語は今の URL（?q=）から読む。ページ移動（nav.js）のあとも、そのときの URL を使う
        _query = (await JS.InvokeAsync<string>("faraIslandSearch.query")).Trim();
        await JS.InvokeVoidAsync("faraIslandSearch.setInput", _query);
        try
        {
            var list = await Http.GetFromJsonAsync("/search-index.json", SearchJsonContext.Default.ListSearchEntry)
                       ?? throw new InvalidOperationException("empty index");
            _index = list.Select(e => new SearchCore.Indexed(e)).ToList();
        }
        catch (Exception ex)
        {
            // Console は WASM で使えない（MissingMethodException を確認済み）。ログは JS の console へ
            await JS.InvokeVoidAsync("console.error", "search index: " + ex.Message);
            _failed = true;
            return;
        }
        if (!string.IsNullOrEmpty(_query)) _hits = SearchCore.Search(_index, _query);
    }

    private bool _readySent;

    // 結果を画面に描いた後に一度だけ知らせる（計測の「操作可能」の目印。DOM に data-ready を付ける）
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_readySent || _index is null) return;
        _readySent = true;
        await JS.InvokeVoidAsync("faraIslandSearch.ready");
    }

    private static (string Label, string Cls) TypeOf(string type) =>
        Types.TryGetValue(type, out var t) ? t : (type, "bg-secondary");

    /// <summary>検索語に一致した部分を &lt;mark&gt; で囲む</summary>
    private RenderFragment Marks(string text) => builder =>
    {
        var seq = 0;
        foreach (var seg in SearchCore.Highlight(text, _query))
        {
            if (seg.Mark)
            {
                builder.OpenElement(seq++, "mark");
                builder.AddContent(seq++, seg.Text);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(seq++, seg.Text);
            }
        }
    };
}
