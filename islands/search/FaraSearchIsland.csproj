<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- 試作（experiment/blazor-island）。本体サイトの検索ページだけに読み込む島。
       検証用の設定: 圧縮ファイル（.br/.gz）は作らない（計測を生のサイズでそろえるため）。
       InvariantGlobalization の有無は、ビルドの引数で切り替える（-p:InvariantGlobalization=false）。 -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CompressionEnabled>false</CompressionEnabled>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.CustomElements" Version="9.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.21" />
  </ItemGroup>

</Project>
