<Project>

  <!--
    C# の静的解析（ラチェット）。ルールの中身と理由は kit の tools/lint/dotnet.editorconfig と docs/lint.md の 2。
    kit の共通の設定を読み、このサイトだけの重大度は tools/lint/dotnet.site.editorconfig（global_level が上）で決める。
    kit のプロジェクト（external/fara-site-kit/src）には、kit の Directory.Build.props が効く（MSBuild は一番近い 1 つだけを読む）。
  -->

  <PropertyGroup>
    <!-- IDE の規則（IDE0059 など）を dotnet build でも検査する -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)external/fara-site-kit/tools/lint/dotnet.editorconfig" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)tools/lint/dotnet.site.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <!-- 非同期の誤用（async void・同期の待ち）を見る。PrivateAssets=all なので、このサイトを参照するプロジェクトには流れない -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" PrivateAssets="all" />
  </ItemGroup>

</Project>
